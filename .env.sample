SECRET_KEY="YOUR SECRET KEY"
ALGORITHM=HS256

EMAIL_HOSTNAME=localhost
EMAIL_PORT=1025
EMAIL_USERNAME=noreply@cinema.local
EMAIL_PASSWORD=
EMAIL_USE_TLS=False

# --- Database (PostgreSQL, required) ---
# For the app / alembic on the host, against the Postgres container from docker-compose
# (user/password/db are the compose defaults: cinema/cinema/cinema):
DATABASE_URL=postgresql+asyncpg://cinema:cinema@localhost:5432/cinema
#
# Inside docker-compose DATABASE_URL and BROKER_URL are overridden, hosts become service names (db, redis).
# Do NOT put POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB here: Settings forbids unknown keys in .env.
# Override them in the shell instead, e.g. `POSTGRES_PASSWORD=... docker compose up`.

# --- Tests ---
# Tests need a running Postgres: `docker compose up -d db`.
# Every pytest worker creates and drops its own database <name>_<worker_id>, the base name is never touched.
# TEST_DATABASE_URL=postgresql+asyncpg://cinema:cinema@localhost:5432/cinema_test

# --- File storage (MinIO) ---
# Keys are the MinIO admin login from docker-compose (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD, defaults minioadmin).
# Inside compose S3_ENDPOINT_URL is overridden to http://minio:9000.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# S3_ENDPOINT_URL=http://localhost:9000
# S3_PUBLIC_URL=http://localhost:9000
# S3_BUCKET=avatars

# --- Celery ---
BROKER_URL=redis://localhost:6379/0

# Optional overrides (defaults live in src/core/config.py)
# APP_BASE_URL=http://127.0.0.1:8000
# FRONTEND_URL=https://cinema.example   # "log in" links in emails go to {FRONTEND_URL}/login; not set = Swagger /docs
# PASSWORD_MIN_LENGTH=8
# PAGINATION_MAX_PER_PAGE=20
